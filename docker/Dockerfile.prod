# Используем официальный образ Python 3.12
FROM python:3.12-slim-bookworm

ENV TZ=Europe/Moscow
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Устанавливаем системные зависимости
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем менеджер пакетов uv (опционально, но рекомендуется)
RUN pip install --no-cache-dir uv

# Создаем рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей (если есть)
COPY requirements-prod.txt ./

# Устанавливаем зависимости из  requirements-prod.txt
RUN uv pip install --system -r  requirements-prod.txt

# Очищаем кэш и временные файлы
RUN apt-get purge -y build-essential python3-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /root/.cache/pip \
    && rm  requirements-prod.txt 

# Устанавливаем переменные окружения
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app
